# Public site: Let's Encrypt via the DNS-01 challenge (OVH API) — no inbound
# port is needed to obtain the certificate.
{{ drive_domain }} {
    tls {
        dns ovh {
            endpoint {{ drive_ovh_endpoint }}
            application_key {{ drive_ovh_application_key }}
            application_secret {{ drive_ovh_application_secret }}
            consumer_key {{ drive_ovh_consumer_key }}
        }
    }
    reverse_proxy nextcloud:80
    encode gzip
}

# Plain-HTTP LAN access (fallback/debug): proxied without TLS.
http://{{ ansible_host }}, http://drive.lab.local {
    reverse_proxy nextcloud:80
}
