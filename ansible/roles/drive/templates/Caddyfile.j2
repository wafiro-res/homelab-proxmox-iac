# Public site: automatic Let's Encrypt TLS.
# The public 443 belongs to the router's VPN server, so only the HTTP-01
# challenge (port 80) can succeed: the TLS-ALPN challenge is disabled.
{{ drive_domain }} {
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    reverse_proxy nextcloud:80
    encode gzip
}

# Plain-HTTP LAN access (fallback/debug): proxied without TLS.
http://{{ ansible_host }}, http://drive.lab.local {
    reverse_proxy nextcloud:80
}
