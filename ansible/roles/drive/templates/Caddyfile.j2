# Public site: Let's Encrypt via the DNS-01 challenge (DuckDNS API) —
# no inbound port is needed to obtain the certificate (the ISP blocks 80).
{{ drive_domain }} {
    tls {
        dns duckdns {{ drive_duckdns_token }}
    }
    reverse_proxy nextcloud:80
    encode gzip
}

# Plain-HTTP LAN access (fallback/debug): proxied without TLS.
http://{{ ansible_host }}, http://drive.lab.local {
    reverse_proxy nextcloud:80
}
