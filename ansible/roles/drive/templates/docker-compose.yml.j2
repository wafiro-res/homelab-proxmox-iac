---
services:
  db:
    image: mariadb:11
    container_name: drive-db
    restart: unless-stopped
    # Flags recommended by the Nextcloud admin manual
    command: --transaction-isolation=READ-COMMITTED --binlog-format=ROW
    environment:
      MARIADB_ROOT_PASSWORD: "{{ drive_db_root_password }}"
      MARIADB_DATABASE: nextcloud
      MARIADB_USER: nextcloud
      MARIADB_PASSWORD: "{{ drive_db_password }}"
    volumes:
      - /srv/drive/db:/var/lib/mysql

  # Memory cache + distributed file locking (best practice for any
  # multi-user instance: avoids conflicts on concurrent file access).
  redis:
    image: redis:alpine
    container_name: drive-redis
    restart: unless-stopped

  nextcloud:
    image: nextcloud:stable
    container_name: drive-nextcloud
    restart: unless-stopped
    depends_on:
      - db
      - redis
    environment:
      MYSQL_HOST: db
      MYSQL_DATABASE: nextcloud
      MYSQL_USER: nextcloud
      MYSQL_PASSWORD: "{{ drive_db_password }}"
      REDIS_HOST: redis
      NEXTCLOUD_TRUSTED_DOMAINS: "{{ ansible_host }} drive.lab.local {{ drive_domain }} {{ drive_domain }}:{{ drive_public_port }}"
      # HTTPS URLs only for requests coming through the Caddy proxy
      # (docker network), so plain-HTTP LAN access keeps working.
      TRUSTED_PROXIES: "172.16.0.0/12"
      OVERWRITEPROTOCOL: https
      OVERWRITECONDADDR: "^172\\..*"
      OVERWRITECLIURL: "https://{{ drive_domain }}:{{ drive_public_port }}"
      PHP_MEMORY_LIMIT: 1G
      PHP_UPLOAD_LIMIT: 16G
    volumes:
      - /srv/drive/nextcloud:/var/www/html

  # Background jobs every 5 min (official recommendation over AJAX cron).
  cron:
    image: nextcloud:stable
    container_name: drive-cron
    restart: unless-stopped
    entrypoint: /cron.sh
    depends_on:
      - db
      - redis
    volumes:
      - /srv/drive/nextcloud:/var/www/html

  # TLS termination with automatic Let's Encrypt certificates.
  caddy:
    image: caddy:2
    container_name: drive-caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /opt/drive/Caddyfile:/etc/caddy/Caddyfile:ro
      - /srv/drive/caddy-data:/data
      - /srv/drive/caddy-config:/config
    depends_on:
      - nextcloud

  # Keeps the DuckDNS record pointing at the home public IP.
  duckdns:
    image: lscr.io/linuxserver/duckdns:latest
    container_name: drive-duckdns
    restart: unless-stopped
    environment:
      SUBDOMAINS: "{{ drive_duckdns_subdomain }}"
      TOKEN: "{{ drive_duckdns_token }}"
      TZ: "Europe/Paris"
