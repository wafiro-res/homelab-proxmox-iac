---
services:
  db:
    image: mariadb:11
    container_name: drive-db
    restart: unless-stopped
    command: --transaction-isolation=READ-COMMITTED --binlog-format=ROW
    environment:
      MARIADB_ROOT_PASSWORD: "{{ drive_db_root_password }}"
      MARIADB_DATABASE: nextcloud
      MARIADB_USER: nextcloud
      MARIADB_PASSWORD: "{{ drive_db_password }}"
    volumes:
      - /srv/drive/db:/var/lib/mysql

  redis:
    image: redis:alpine
    container_name: drive-redis
    restart: unless-stopped

  nextcloud:
    image: nextcloud:stable
    container_name: drive-nextcloud
    restart: unless-stopped
    depends_on:
      - db
      - redis
    ports:
      - "80:80" # LAN / debug access only; the public path goes through the tunnel
    environment:
      MYSQL_HOST: db
      MYSQL_DATABASE: nextcloud
      MYSQL_USER: nextcloud
      MYSQL_PASSWORD: "{{ drive_db_password }}"
      REDIS_HOST: redis
      NEXTCLOUD_TRUSTED_DOMAINS: "{{ ansible_host }} drive.lab.local {{ drive_domain }}"
      TRUSTED_PROXIES: "127.0.0.1 172.16.0.0/12 ::1"
      OVERWRITEPROTOCOL: https
      OVERWRITEHOST: "{{ drive_domain }}"
      OVERWRITECLIURL: "https://{{ drive_domain }}"
      PHP_MEMORY_LIMIT: 1G
      PHP_UPLOAD_LIMIT: 16G
    volumes:
      - /srv/drive/nextcloud:/var/www/html

  cron:
    image: nextcloud:stable
    container_name: drive-cron
    restart: unless-stopped
    entrypoint: /cron.sh
    depends_on:
      - db
      - redis
    volumes:
      - /srv/drive/nextcloud:/var/www/html
{% if drive_cloudflare_tunnel_token is defined and drive_cloudflare_tunnel_token %}

  # Cloudflare Tunnel: outbound-only link to Cloudflare's edge. No inbound
  # port, the home IP stays hidden, TLS is terminated by Cloudflare. The
  # public hostname -> http://nextcloud:80 route is configured in the
  # Cloudflare Zero Trust dashboard.
  cloudflared:
    image: cloudflare/cloudflared:latest
    container_name: drive-cloudflared
    restart: unless-stopped
    network_mode: host
    command: tunnel --no-autoupdate run
    environment:
      TUNNEL_TOKEN: "{{ drive_cloudflare_tunnel_token }}"
    depends_on:
      - nextcloud
{% endif %}
