---
# Routes generated by Ansible from the inventory.
http:
  routers:
    grafana:
      rule: "Host(`grafana.lab.local`)"
      entryPoints: [web]
      service: grafana
    prometheus:
      rule: "Host(`prometheus.lab.local`)"
      entryPoints: [web]
      service: prometheus
    cv:
      rule: "Host(`cv.lab.local`)"
      entryPoints: [web]
      service: cv
{% if groups['drive'] is defined and groups['drive'] | length > 0 %}
    drive:
      rule: "Host(`drive.lab.local`)"
      entryPoints: [web]
      service: drive
{% endif %}

  services:
    grafana:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars[groups['monitoring'] | first].ansible_host }}:3000"
    prometheus:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars[groups['monitoring'] | first].ansible_host }}:9090"
    cv:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars[groups['web'] | first].ansible_host }}:80"
{% if groups['drive'] is defined and groups['drive'] | length > 0 %}
    drive:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars[groups['drive'] | first].ansible_host }}:80"
{% endif %}
