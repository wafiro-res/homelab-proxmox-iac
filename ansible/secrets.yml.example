---
# Copy this file to secrets.yml (git-ignored) on the control node and fill in
# the real values, then run:  ansible-playbook site.yml -e @secrets.yml
# Next step some day: encrypt it with Ansible Vault instead.
drive_db_password: "a-strong-password"
drive_db_root_password: "another-strong-password"

# Cloudflare Tunnel token: create the tunnel in the Cloudflare Zero Trust
# dashboard (Networks -> Tunnels), copy the token from the install command.
drive_cloudflare_tunnel_token: "your-cloudflare-tunnel-token"
