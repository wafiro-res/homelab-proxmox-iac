---
# Copy this file to secrets.yml (git-ignored) on the control node and fill in
# the real values, then run:  ansible-playbook site.yml -e @secrets.yml
# Next step some day: encrypt it with Ansible Vault instead.
drive_db_password: "a-strong-password"
drive_db_root_password: "another-strong-password"

# OVH API credentials for the ACME DNS-01 challenge.
# Create them at https://api.ovh.com/createToken/ with GET/PUT/POST/DELETE
# on /domain/zone/*
drive_ovh_application_key: "your-ovh-application-key"
drive_ovh_application_secret: "your-ovh-application-secret"
drive_ovh_consumer_key: "your-ovh-consumer-key"
