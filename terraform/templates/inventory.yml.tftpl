---
# Generated by Terraform - do not edit by hand.
all:
  vars:
    ansible_user: ${username}
  children:
%{ for group in distinct([for v in vms : v.group]) ~}
    ${group}:
      hosts:
%{ for name, v in vms ~}
%{ if v.group == group ~}
        ${name}:
          ansible_host: ${split("/", v.ip)[0]}
%{ endif ~}
%{ endfor ~}
%{ endfor ~}
